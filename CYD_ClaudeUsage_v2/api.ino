static void headerFloat(HTTPClient& h, const char* name, float& out, bool& found) {
    String v = h.header(name);
    if (v.length()) { out = v.toFloat(); found = true; }
}

void fetchUsage(const char* tok, UsageData& out) {
    out.ok = false;
    out.limited = false;
    out.httpCode = 0;
    out.error[0] = 0;

    if (WiFi.status() != WL_CONNECTED) {
        out.httpCode = -100;
        strlcpy(out.error, "Wi-Fi is not connected.", sizeof(out.error));
        return;
    }

    WiFiClientSecure client;
    client.setCACert(ROOT_CA);

    HTTPClient https;
    if (!https.begin(client, MESSAGES_ENDPOINT)) {
        strlcpy(out.error, "Couldn't start HTTPS.", sizeof(out.error));
        return;
    }

    https.addHeader("Authorization",     String("Bearer ") + tok);
    https.addHeader("anthropic-version", ANTHROPIC_VERSION);
    https.addHeader("anthropic-beta",    "oauth-2025-04-20");
    https.addHeader("content-type",      "application/json");
    https.addHeader("User-Agent",        "claude-code/2.1.5");
    https.setTimeout(API_TIMEOUT_MS);
    https.collectAllHeaders();

    static const char BODY[] = "{\"model\":\"" PROBE_MODEL "\","
                               "\"max_tokens\":1,"
                               "\"messages\":[{\"role\":\"user\",\"content\":\".\"}]}";

    int code = https.POST((uint8_t*)BODY, sizeof(BODY) - 1);
    out.httpCode = code;
    Serial.printf("[API] HTTP %d\n", code);

    if (code <= 0) {
        snprintf(out.error, sizeof(out.error), "No response from Claude (%d).", code);
        https.end();
        return;
    }

    // Log every rate-limit header — handy for spotting new ones
    for (int i = 0; i < https.headers(); i++) {
        String n = https.headerName(i);
        if (n.startsWith("anthropic-ratelimit")) Serial.printf("[API]   %s: %s\n", n.c_str(), https.header(i).c_str());
    }

    bool have5 = false, have7 = false;
    float h5u = 0, d7u = 0;
    headerFloat(https, "anthropic-ratelimit-unified-5h-utilization", h5u, have5);
    headerFloat(https, "anthropic-ratelimit-unified-7d-utilization", d7u, have7);
    // Reset times are 10-digit epochs: parse as integers (a float would round them)
    uint32_t h5r = strtoul(https.header("anthropic-ratelimit-unified-5h-reset").c_str(), nullptr, 10);
    uint32_t d7r = strtoul(https.header("anthropic-ratelimit-unified-7d-reset").c_str(), nullptr, 10);
    String status = https.header("anthropic-ratelimit-unified-status");
    https.end();

    if (!have5 && !have7) {
        if (code == 401 || code == 403) strlcpy(out.error, "Token rejected.", sizeof(out.error));
        else snprintf(out.error, sizeof(out.error), "Unexpected reply from Claude (HTTP %d).", code);
        return;
    }

    out.h5           = h5u * 100.0f;
    out.d7           = d7u * 100.0f;
    out.h5ResetEpoch = h5r;
    out.d7ResetEpoch = d7r;
    out.limited      = (status == "rejected") || code == 429;
    out.ok           = true;
    Serial.printf("[API] 5h=%.1f%% 7d=%.1f%% status=%s\n", out.h5, out.d7, status.c_str());
}
